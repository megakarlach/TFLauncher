<Window x:Class="TFLauncher.TF_Help_TF4K_Controls_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cefSharp="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        xmlns:local="clr-namespace:TFLauncher"
        mc:Ignorable="d"
        Title="TetFuck HQ Help" Height="415" Width="549" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="53*"/>
            <RowDefinition Height="332*"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF001418" Offset="0"/>
                <GradientStop Color="#FF1A466A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <cefSharp:ChromiumWebBrowser x:Name="browserwnd" Grid.Row="0" Address="https://megakarlach.github.io/tetfuckupload/help/controls_tetfuck4k.html" Margin="0,0,0,50" Grid.RowSpan="2" />
        <Button x:Name="OKbtn" MouseEnter="ButtonSFX_MouseEnter" MouseLeave="ButtonSFX_MouseLeave"  Content="OK" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="90" Height="30" Click="OKbtn_Click" Foreground="Black" BorderBrush="#FFAAAAAA" Grid.Row="1" FontFamily="/TFLauncher;component/resources/#Univers Condensed" FontSize="16">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFF2F6F8" Offset="0"/>
                    <GradientStop Color="#FFE0EFF9" Offset="1"/>
                    <GradientStop Color="#FFD8E1E7" Offset="0.5"/>
                    <GradientStop Color="#FFB5C6D0" Offset="0.51"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Label x:Name="labellaunchercopyright" Content="* TetFuck Online Help requires Internet Connection to function.&#xD;&#xA;If you don't have internet connection, go to &quot;TetFuck HQ\docs\help&quot; directory." Foreground="White" FontFamily="/TFLauncher;component/resources/#Univers Condensed" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="42" Grid.Row="1" Width="416"/>
    </Grid>
</Window>
