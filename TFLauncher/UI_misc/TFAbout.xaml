<Window x:Class="TFLauncher.TFAbout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cefSharp="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        xmlns:local="clr-namespace:TFLauncher"
        mc:Ignorable="d"
        Title="About TetFuck HQ Launcher" Height="415" Width="517" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="337*"/>
            <RowDefinition Height="48*"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF180700" Offset="0"/>
                <GradientStop Color="#FF6A461A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Image x:Name="imageRR" Margin="205,114,0,0" Source="/TFLauncher;component/materials/bg/RR_Spirit_of_Ecstasy.png" Opacity="0.24" Grid.RowSpan="2"/>
        <Image x:Name="imageEA" Margin="0,114,241,0" Source="/TFLauncher;component/materials/bg/ea_sports_2011.png" Opacity="0.24" Grid.RowSpan="2"/>
        <Image x:Name="TF_banner" Margin="0,0,0,255" Source="../materials/tfhq_banner.png"/>
        <Button x:Name="OKbtn" MouseEnter="ButtonSFX_MouseEnter" MouseLeave="ButtonSFX_MouseLeave"  Content="OK" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="90" Height="30" Click="OKbtn_Click" Foreground="Black" BorderBrush="#FFAAAAAA" Grid.Row="1" FontFamily="/TFLauncher;component/resources/#Univers Condensed" FontSize="16">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFF2F6F8" Offset="0"/>
                    <GradientStop Color="#FFE0EFF9" Offset="1"/>
                    <GradientStop Color="#FFD8E1E7" Offset="0.5"/>
                    <GradientStop Color="#FFB5C6D0" Offset="0.51"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="brokenBtn" MouseEnter="ButtonSFX_MouseEnter" MouseLeave="ButtonSFX_MouseLeave" Content="super secret broken video" HorizontalAlignment="Left" Margin="10,0,0,10" VerticalAlignment="Bottom" Width="165" Height="30" Click="brokenBtn_Click" Foreground="#14000000" BorderBrush="#0C4F3C07" Background="#00000000" Grid.Row="1"/>
        <Label x:Name="labellaunchername" Content="TetFuck HQ Launcher" Foreground="White" FontFamily="Arial MT Medium" FontSize="20" Margin="10,87,0,0" Background="#00000000" HorizontalAlignment="Left" VerticalAlignment="Top" Height="36"/>
        <Label x:Name="labellauncheraboutver" Content="Version (ver) Build (build num) (date)" Foreground="White" FontFamily="/TFLauncher;component/resources/#Univers Condensed" Margin="0,88,0,0" FontSize="13.333" VerticalAlignment="Top" HorizontalAlignment="Right" Width="211"/>
        <Label x:Name="labellauncherdesc" Content="A Launcher for TetFuck Games. Built using .NET &amp; C#" Foreground="White" FontFamily="/TFLauncher;component/resources/#Univers Condensed" FontSize="11" Margin="10,128,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26"/>
        <Label x:Name="labellaunchergames" Content="Includes:  TetFuck 2142, 4K, Five,  TetRizz and Kunny Krysis" Foreground="White" FontFamily="/TFLauncher;component/resources/#Univers Condensed" FontSize="11" Margin="10,154,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26"/>
        <Label x:Name="labellauncherdev" Content="Developed by leonidakarlach &amp; TetFuck Company" Foreground="White" FontFamily="/TFLauncher;component/resources/#Univers Condensed" FontSize="11" Margin="10,180,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26"/>
        <Label x:Name="labellaunchercopyright" Content="© 2015 - 2026  The TetFuck Company &amp; SLUT TECH/Starfuckers Inc.&#xA;© 2012 Electronic Arts Inc.&#xA;Spirit of Ecstasy logo/icon © Rolls-Royce Motor Cars.&#xA;Tetris® &amp; © 1985 - 2026  Tetris Holding.  Tetris logos, Tetris theme song and  Tetriminos are &#xA;trademarks of  Tetris Holding.  The Tetris trade dress is owned by  Tetris Holding. &#xA;Tetris Game Design by Alexey Pajitnov. All Rights Reserved.&#xA;NOT AN LICENSED FIFA OR  TETRIS PRODUCT." Foreground="White" FontFamily="/TFLauncher;component/resources/#Univers Condensed" FontSize="11.333" Margin="10,211,10,0" VerticalAlignment="Top" Height="128" Grid.RowSpan="2"/>

    </Grid>
</Window>
