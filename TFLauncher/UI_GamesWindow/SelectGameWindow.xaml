            <Button x:Name="OpenMoreGamesBtn" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="950,6,1,74.625" MouseEnter="ButtonSFX_MouseEnter" MouseLeave="ButtonSFX_MouseLeave" Content="Play TetFuck V" FontFamily="Tahoma" FontSize="36" FontWeight="Bold" Click="OpenMoreGamesBtn_Click" OpacityMask="#FF65C95C" BorderBrush="#FFAAC1FD" Foreground="#00000000" BorderThickness="1" SnapsToDevicePixels="True" Grid.Column="1" Grid.ColumnSpan="2">
                <Button.Background>
