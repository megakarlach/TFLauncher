            <Button x:Name="OpenTetFuck4000" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="316,6,631,74.625" Content="Play TetFuck 4K" MouseEnter="ButtonSFX_MouseEnter" MouseLeave="ButtonSFX_MouseLeave" FontFamily="Tahoma" FontSize="36" FontWeight="Bold" Click="OpenTetFuck4000_Click" OpacityMask="#FFE8DBC4" BorderBrush="#FFD9233B" Foreground="#00000000" BorderThickness="1" SnapsToDevicePixels="True" Grid.Column="1">
