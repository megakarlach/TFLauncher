            <Button x:Name="OpenTetFuck5000"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="633,6,314,74.625" Content="Play TetFuck V" MouseEnter="ButtonSFX_MouseEnter" MouseLeave="ButtonSFX_MouseLeave" FontFamily="Tahoma" FontSize="36" FontWeight="Bold" Click="OpenTetFuck5000_Click" OpacityMask="#FF65C95C" BorderBrush="#FFCAFDAA" Foreground="#00000000" BorderThickness="1" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5" Grid.Column="1">
