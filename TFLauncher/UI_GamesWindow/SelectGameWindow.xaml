        <!-- bottom bar grid -->
        <!-- select game toolbar -->
        <Grid ScrollViewer.VerticalScrollBarVisibility="Disabled" UseLayoutRounding="False" Grid.IsSharedSizeScope="True" Height="155.625" VerticalAlignment="Bottom" ClipToBounds="True" HorizontalAlignment="Center" Width="1272">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2" MinWidth="2"/>
                <ColumnDefinition Width="Auto" MinWidth="1263"/>
                <ColumnDefinition Width="2" MinWidth="2"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenTetFuck2142"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2,6,948,74.625" Content="Play TetFuck 2142" MouseEnter="ButtonSFX_MouseEnter" MouseLeave="ButtonSFX_MouseLeave" Click="OpenTetFuck2142_Click" RenderTransformOrigin="0.5,0.5" FontFamily="/TFLauncher;component/resources/#Marker Felt" Foreground="#00000000" OpacityMask="#FFC164BD" BorderBrush="#FFB841FF" BorderThickness="1" SnapsToDevicePixels="True" Grid.ColumnSpan="2">
                <Button.Background>
                    <ImageBrush ImageSource="/TFLauncher;component/materials/btn_newredesign2013/menuoptions/btn-tf2142-13.png"/>
                </Button.Background>
