                </Button.Background>
            </Button>
            <Button x:Name="QuitBtn"  MouseEnter="ButtonSFX_MouseEnter" MouseLeave="ButtonSFX_MouseLeave" Content="" Margin="0,0,10,3.625" Click="QuitBtn_Click" BorderBrush="{x:Null}" Foreground="White" FontSize="28" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" Width="66" HorizontalContentAlignment="Right" ScrollViewer.VerticalScrollBarVisibility="Disabled" Height="68" VerticalAlignment="Bottom" Grid.Column="1">
